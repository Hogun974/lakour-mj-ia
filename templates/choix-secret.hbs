<section class="lakour-mjia-decision-corps">
  <header class="lakour-mjia-decision-tete">
    <i class="fa-solid fa-user-secret"></i>
    <div>
      {{#if titre}}<div class="lakour-mjia-etiquette">{{titre}}</div>{{/if}}
      <p class="lakour-mjia-question">{{question}}</p>
    </div>
    <div class="lakour-mjia-minuteur"></div>
  </header>
  <p class="hint">{{localize "LAKOUR_MJIA.Decisions.Secret"}}</p>
  <ul class="lakour-mjia-options">
    {{#each options}}
    <li>
      <button type="button" class="lakour-mjia-option {{#if choisi}}choisi{{/if}}" data-action="choisir" data-index="{{index}}" aria-pressed="{{#if choisi}}true{{else}}false{{/if}}">
        <span>{{libelle}}</span>
        {{#if choisi}}<i class="fa-solid fa-check"></i>{{/if}}
      </button>
    </li>
    {{/each}}
  </ul>
  <footer class="lakour-mjia-boutons">
    <button type="button" data-action="passer"><i class="fa-solid fa-forward"></i> {{localize "LAKOUR_MJIA.Decisions.Passer"}}</button>
    <button type="button" data-action="valider" {{#unless peutValider}}disabled{{/unless}}><i class="fa-solid fa-check"></i> {{localize "LAKOUR_MJIA.Decisions.Valider"}}</button>
  </footer>
</section>
